# Copy to .env.local (which git ignores) and fill in. Never commit the real values.
#
# Without these, Tipon still works: the Dump page sorts with the rules from Block 4,
# on your device, for nothing.

# Your Claude API key, from https://console.anthropic.com. Server-side only: it is read
# in src/app/api/extract/route.ts and never reaches the browser.
# Set a monthly spend limit in the Console before you use it.
ANTHROPIC_API_KEY=

# A password you make up. Anyone who has it can spend your Claude credits through your
# deployed copy of Tipon, so keep it to yourself. Leave it unset and /api/extract stays off.
TIPON_ACCESS_CODE=
